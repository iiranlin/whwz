# 页面标题
VITE_APP_TITLE = 仓储信息管理系统

# 生产环境配置
VITE_APP_ENV = 'production'

# 仓储信息管理系统/生产环境
VITE_APP_BASE_API = '/api'

# 是否在打包时开启压缩，支持 gzip 和 brotli
VITE_BUILD_COMPRESS = gzip

#后台服务前缀
VITE_APP_BASE_SSO_BASE = '/integrated-manage'
VITE_APP_BASE_SSO_AUTH = '/sso-auth'
VITE_APP_BASE_SSO_MANAGE_BASE = '/tempalte-bankend-base'
VITE_APP_BASE_WAREHOUSE = '/warehouse'
VITE_APP_BASE_PURCH_MANAGE = '/purch-manage'
VITE_APP_BASE_POOL_BASE = '/res-pool'
VITE_APP_BASE_WORKFLOE_NEW = '/workflow-new'

# 标品 base 服务前缀（prodmgr-gateway 按 Nacos 服务名路由，blcd-base 为 base 服务注册名）
VITE_APP_BASE_BASE_SERVICE = '/blcd-base'

# 前端部署前缀
VITE_PUBLIC_PATH = '/warehouse-v3'

#登录页地址
VITE_APP_BASE_LOGIN_URL = 'http://localhost:8000'